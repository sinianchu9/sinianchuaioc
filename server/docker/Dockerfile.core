# Build stage
FROM golang:1.23-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /app

# Copy go mod files
COPY core-go/go.mod core-go/go.sum ./
RUN go mod download

# Copy source code
COPY core-go/ .

# Build binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /core main.go

# Runtime stage
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app

COPY --from=builder /core .
COPY configs/ ./configs/

EXPOSE 8081

ENV CONFIG_PATH=/app/configs/config.yaml

CMD ["./core"]
